{
  "name": "powerbuilder",
  "publisher": "micha4w",
  "displayName": "PowerBuilder",
  "description": "PowerBuilder Syntax and Language Server",
  "repository": {
    "type": "git",
    "url": "https://github.com/micha4w/powerbuilder-ls"
  },
  "version": "0.0.0-git",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "powerbuilder",
        "aliases": [
          "PowerBuilder",
          "powerbuilder"
        ],
        "extensions": [
          ".sru",
          ".srd",
          ".srm",
          ".srw",
          ".srs",
          ".srf",
          ".sra",
          ".srp",
          ".srj",
          ".srq"
        ],
        "configuration": "./lang/language-configuration.json",
        "icon": {
          "dark": "./icons/powerbuilder.png",
          "light": "./icons/powerbuilder.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "powerbuilder",
        "scopeName": "source.powerbuilder",
        "path": "./lang/PowerBuilder.tmbundle/Syntaxes/PowerBuilder.tmLanguage.json"
      },
      {
        "scopeName": "markdown.powerbuilder.codeblock",
        "path": "./lang/codeblock.tmGrammar.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.powerbuilder": "powerbuilder"
        }
      }
    ],
    "commands": [
      {
        "command": "powerbuilder.restartLs",
        "title": "Restart Language Server",
        "category": "PowerBuilder",
        "enablement": "powerbuilder.lsFound"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "PowerBuilder",
      "properties": {
        "powerbuilder.languageServer.path": {
          "type": "string"
        },
        "powerbuilder.languageServer.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error",
            "off"
          ],
          "default": "warn"
        }
      }
    }
  },
  "activationEvents": [
    "workspaceContains:*.pbsln"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "vscode:package": "npm run vscode:prepublish && vsce package --no-dependencies",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "proxyquire": "^2.1.3",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@types/which": "^3.0.4",
    "source-map-support": "^0.5.21",
    "vscode-languageclient": "^10.1.0",
    "which": "^7.0.0"
  }
}
